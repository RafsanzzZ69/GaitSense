# Supply the real Atlas URI privately. Never place this in EXPO_PUBLIC_*.
MONGODB_URI=mongodb+srv://DATABASE_USER:PASSWORD@YOUR_CLUSTER.mongodb.net/?authSource=admin
MONGO_DATABASE=gaitsense
# Generate locally with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:8081","http://localhost:8082"]
STORAGE_PROVIDER=local
STORAGE_PATH=storage
MAX_UPLOAD_MB=200
VIDEO_RETENTION_DAYS=30
POSE_MODEL_PATH=../frontend/modules/gaitsense-pose/android/src/main/assets/pose_landmarker_full.task
# Private S3-compatible bucket, if STORAGE_PROVIDER=s3:
# S3_BUCKET=gaitsense-private
# S3_ENDPOINT_URL=https://your-object-storage-endpoint
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=us-east-1
